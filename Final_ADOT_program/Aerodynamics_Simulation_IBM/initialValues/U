#include "initialConditions";

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;


    }
    
    outlet
    {
        type            inletOutlet;


    }

    lower
    {
        type           fixedValue;


    }

    upper
    {
        type           inletOutlet;


    }

    front
    {
        type           inletOutlet;


    }

    back
    {
        type           inletOutlet;

        
    }

    "proc.*"
    {
        type            processor;
    }
}


