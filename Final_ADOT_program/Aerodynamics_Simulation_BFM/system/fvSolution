FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        tolerance       1e-08;
        relTol          0;
        smoother        GaussSeidel;
        nPreSweeps      0;
        nPostSweeps     2;
        cacheAgglomeration on;
        agglomerator    faceAreaPair;
        nCellsInCoarsestLevel 10;
        mergeLevels     1;
    }

    pFinal
    {
        $p;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0;
    }

    /*UFinal
    {
        type coupled;
        solver PBiCCCG;
        preconditioner DILU;
        tolerance (1e-08 1e-08 1e-08);
        relTol (0 0 0);
        minIter 3;
    }*/

    UFinal
    {
        $U;
    }
    
    Phi{
        $p;
    }
}

PIMPLE
{
    momentumPredictor   yes;
    nCorrectors     2;
    nOuterCorrectors    1;
    nOrthogonalCorrectors 1;
    pRefCell        0;
    pRefValue       0;
}

potentialFlow
{
    nNonOrthogonalCorrectors 20;
    pRefCell        0;
    pRefValue       0;
    PhiRefCell 0;
    PhiRefValue 0.0;
}